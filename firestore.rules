rules_version = '2';

// Cada usuário só enxerga e grava os próprios dados:
//   users/{uid}                  -> anotações globais, caderno e configurações
//   users/{uid}/reports/{data}   -> tasks e comentários de um dia (id = AAAA-MM-DD)
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['queue', 'notebook', 'settings', 'updatedAt'])
        && request.resource.data.queue is string
        && request.resource.data.notebook is string
        && request.resource.data.settings is map;

      match /reports/{date} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && request.resource.data.keys().hasOnly(['tasks', 'comments', 'folga', 'updatedAt'])
          && request.resource.data.tasks is list
          && request.resource.data.tasks.size() <= 300
          && request.resource.data.comments is string
          && request.resource.data.get('folga', false) is bool;
      }

      match /history/{versionId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['date', 'tasks', 'comments', 'folga', 'createdAt'])
          && request.resource.data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && request.resource.data.tasks is list
          && request.resource.data.tasks.size() <= 300
          && request.resource.data.comments is string
          && request.resource.data.folga is bool;
        allow update: if false;
      }
    }
  }
}
